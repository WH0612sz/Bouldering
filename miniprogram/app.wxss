page{background:#f4f6f1;color:#202522;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:28rpx}view,button,input,video{box-sizing:border-box}button{font-size:28rpx;border-radius:20rpx;background:#fff;color:#202522}button::after{border:0}.page{padding:28rpx 36rpx 50rpx}.primary{background:#b7c9a5;font-weight:600}.muted{font-size:24rpx;color:#71806f;line-height:1.7}.title{font-weight:650;font-size:34rpx}.card{background:#fff;border:1rpx solid #e3e9df;border-radius:28rpx;padding:28rpx}.row{display:flex;align-items:center;gap:20rpx}.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section{margin-top:32rpx}.field{background:#fff;border:1rpx solid #dde5d8;border-radius:16rpx;padding:20rpx;margin-top:12rpx;height:88rpx}.label{font-size:26rpx;color:#5e6e5c}.error{color:#ab493f;font-size:25rpx;line-height:1.7}.empty{text-align:center;padding:80rpx 24rpx}.pill{font-size:22rpx;color:#63755c;background:#edf2e8;padding:7rpx 14rpx;border-radius:12rpx}.action{color:#405e39;font-size:26rpx}.sheet-mask{position:fixed;inset:0;background:#16211966;z-index:100;display:flex;align-items:flex-end}.sheet{background:#f9fbf6;border-radius:36rpx 36rpx 0 0;width:100%;max-height:85vh;overflow:auto;padding:40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom))}.sheet button{margin-top:20rpx}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}

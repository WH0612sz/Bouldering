.video{width:100%;height:56vh;min-height:600rpx;background:#202522;border-radius:28rpx}.pending{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;color:#fff}.pending .muted{color:#c5d0bf}
.player{position:relative}
.pose-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.detail-tabs{display:flex;gap:42rpx;border-bottom:1rpx solid #e5e9e2;align-items:center}
.detail-tabs .current-tab{padding:18rpx 0;border-bottom:4rpx solid #819c71;font-weight:600}
.detail-tabs .upcoming-tab{margin:0;padding:0;background:transparent;color:#8b948a;line-height:2}
.layer-controls{display:flex;gap:24rpx;font-size:24rpx;color:#59665a}
.layer-controls label{display:flex;align-items:center}
.layer-controls switch{transform:scale(.7);transform-origin:left center}
.motion-row{display:flex;align-items:center;gap:12rpx;margin-top:18rpx}
.motion-label{width:66rpx;color:#69716b;font-size:22rpx}
.motion-lane{flex:1;position:relative;height:28rpx;background:#edf1ea;border-radius:8rpx;overflow:hidden}
.motion-span{position:absolute;top:4rpx;height:20rpx;background:#819c71;border-radius:5rpx}
.motion-span.unknown{background:#cbd1cb}
.motion-cursor{position:absolute;top:0;height:100%;width:3rpx;background:#364d32;pointer-events:none}

.record-page{padding:20rpx 30rpx 24rpx}.dev{font-size:21rpx;color:#7a8973;margin-bottom:14rpx}.recover{background:#e4eddc;padding:18rpx;border-radius:14rpx;font-size:24rpx;margin-bottom:16rpx}.camera-box{height:57vh;min-height:580rpx;position:relative;border-radius:28rpx;overflow:hidden;background:#253229}.camera{width:100%;height:100%}.camera-fallback{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:24rpx;color:#dfe9d9;font-size:24rpx}.heading{font-size:36rpx;color:#fff}.camera-fallback button{background:#b7c9a5}.record-time{position:absolute;top:24rpx;left:28rpx;color:#fff;font-size:25rpx;background:#26392d99;padding:10rpx 16rpx;border-radius:12rpx}.camera-controls{padding:24rpx 12rpx 12rpx}.mode{text-align:center;font-size:24rpx;color:#6c7c62;margin-bottom:20rpx}.buttons{display:flex;align-items:center;justify-content:space-around}.small{background:transparent;font-size:23rpx;line-height:1.5;padding:0;min-width:100rpx}.album-icon,.flip-icon{font-size:52rpx;margin-bottom:8rpx}.shutter{width:138rpx;height:138rpx;border:5rpx solid #758b6b;border-radius:50%;padding:9rpx;background:transparent}.shutter view{height:100%;width:100%;background:#ce7161;border-radius:50%}.shutter.recording view{border-radius:14rpx;transform:scale(.55)}

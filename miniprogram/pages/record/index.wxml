<topbar title="记录"/><view class="record-page"><view wx:if="{{local}}" class="dev">本地联调环境</view><view wx:if="{{recover}}" class="recover" bindtap="recover">上次提交尚未确认，点击恢复 ›</view><view class="camera-box"><camera wx:if="{{camera}}" class="camera" mode="normal" device-position="{{position}}" flash="off" binderror="cameraError" bindstop="interrupted"/><view wx:if="{{!camera}}" class="camera-fallback"><text class="heading">准备记录你的攀爬</text><text>允许使用相机和麦克风后开始录像</text><button bindtap="enable">开启相机</button></view><cover-view class="record-time">{{recording ? '● 录制中 ' : 'VIDEO '}}{{time}}</cover-view></view><view class="camera-controls"><view class="mode">{{recording?'点击停止，确认后再保存':'视频'}}</view><view class="buttons"><button bindtap="album" disabled="{{recording}}" class="small"><view class="album-icon">▧</view><view>相册</view></button><button bindtap="shoot" disabled="{{!camera}}" class="shutter {{recording?'recording':''}}"><view/></button><button bindtap="flip" disabled="{{recording}}" class="small"><view class="flip-icon">↻</view><view>翻转</view></button></view></view></view>

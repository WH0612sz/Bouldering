.profile{display:flex;align-items:center;gap:24rpx;margin:12rpx 0 36rpx}.avatar{width:112rpx;height:112rpx;line-height:112rpx;border-radius:50%;padding:0;background:#d5e1cd;color:#4a6046;font-size:42rpx;margin:0}.avatar image{width:100%;height:100%}.profile-name{flex:1}.stats{display:flex;justify-content:space-around;text-align:center}.stats text{font-size:42rpx;font-weight:650}.stats view view{font-size:23rpx;color:#73816c;margin-top:8rpx}.tabs{display:flex;gap:48rpx;border-bottom:1rpx solid #e0e6dc}.tabs text{padding-bottom:20rpx;color:#819079}.tabs .selected{color:#30462c;border-bottom:4rpx solid #8fa581}.record{display:flex;align-items:center;gap:22rpx;padding:28rpx 0;border-bottom:1rpx solid #e3e8de}.thumb{width:120rpx;height:150rpx;border-radius:18rpx;flex-shrink:0;background:#e5ebdf}.placeholder{display:flex;align-items:center;justify-content:center;color:#74866b;font-size:24rpx}.record-body{flex:1;min-width:0}.record-name{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:10rpx}.more{padding:16rpx 8rpx;color:#7b8d72}

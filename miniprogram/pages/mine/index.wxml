<topbar title="我的"/><view class="page"><view class="profile"><button open-type="chooseAvatar" bindchooseavatar="avatar" class="avatar"><image wx:if="{{profile.avatar_url}}" src="{{profile.avatar_url}}"/><text wx:else>攀</text></button><view class="profile-name"><view class="title">{{profile.nickname||'攀岩爱好者'}}</view><view class="muted">记录每一次攀爬</view></view><text class="action" bindtap="editProfile">编辑 ›</text></view><view class="stats card"><view><text>{{profile.stats.videos||0}}</text><view>分析视频</view></view><view><text>{{profile.stats.days||0}}</text><view>记录天数</view></view><view><text>{{profile.stats.routes||0}}</text><view>线路组</view></view></view><view class="title section">分析记录</view><view class="tabs section"><text class="{{view==='videos'?'selected':''}}" data-view="videos" bindtap="view">全部视频</text><text class="{{view==='routes'?'selected':''}}" data-view="routes" bindtap="view">按线路</text></view><picker wx:if="{{view==='videos'}}" range="{{filters}}" value="{{filter}}" bindchange="filter"><view class="muted section">{{filters[filter]}} ▾ · 最新上传在前</view></picker><view wx:if="{{filterRouteName}}" class="muted section" bindtap="clearRoute">线路：{{filterRouteName}} · 清除筛选 ×</view><view wx:if="{{error}}" class="error section" bindtap="reload">{{error}} · 点击重试</view><block wx:if="{{view==='videos'}}"><view wx:for="{{items}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.poster_url}}" class="thumb" src="{{item.poster_url}}" mode="aspectFill"/><view wx:else class="thumb placeholder">视频</view><view class="record-body"><view class="record-name">{{item.name}}</view><view class="muted">{{item.climb_date}} · {{item.completion}}</view><view class="muted">{{item.route_name||'未归组'}} · {{item.state==='PLAYABLE'?'已保存':item.state==='FAILED'?'准备失败':'准备播放中'}}</view></view><view class="more" data-id="{{item.id}}" catchtap="edit">•••</view></view><view wx:if="{{!items.length&&!loading&&!error}}" class="empty"><view class="muted">还没有符合条件的视频记录</view><button class="primary section" bindtap="record">去记录</button></view><view class="muted section">{{loading?'加载中…':cursor?'上拉加载更多':'已显示全部'}}</view></block><block wx:else><view wx:for="{{routes}}" wx:key="id" class="record between" data-id="{{item.id}}" bindtap="route"><text>{{item.name}}</text><text class="muted">{{item.count}} 次尝试 ›</text></view><view wx:if="{{!routes.length}}" class="empty muted">暂无线路，编辑视频即可归组</view></block></view><view wx:if="{{edit||profileEdit}}" class="sheet-mask" bindtap="close"><view class="sheet" catchtap="noop"><block wx:if="{{edit}}"><view class="title">管理视频记录</view><input class="field section" value="{{editName}}" maxlength="80" data-key="editName" bindinput="input"/><picker mode="date" value="{{editDate}}" bindchange="date"><view class="field">攀爬日期：{{editDate}} ›</view></picker><picker range="{{statuses}}" value="{{editCompletion}}" bindchange="status"><view class="field">完成情况：{{statuses[editCompletion]}} ›</view></picker><picker range="{{groupNames}}" value="{{editGroup}}" bindchange="group"><view class="field">线路：{{groupNames[editGroup]}} ›</view></picker><view class="muted section">新线路名称（填写后覆盖当前归组）</view><input class="field" value="{{editRouteName}}" maxlength="60" data-key="editRouteName" bindinput="input" placeholder="留空保留当前线路"/><button bindtap="save" class="primary" loading="{{saving}}" disabled="{{saving}}">保存修改</button><button bindtap="remove" class="error">删除视频</button></block><block wx:else><view class="title">编辑资料</view><input class="field section" type="nickname" value="{{nickname}}" maxlength="24" data-key="nickname" bindinput="input"/><button class="primary" bindtap="saveProfile">保存</button></block><button bindtap="close">取消</button></view></view>
